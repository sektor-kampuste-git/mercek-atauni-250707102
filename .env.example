# Mercek — ortam değişkenleri şablonu
# Bu dosyayı .env adıyla kopyalayıp kendi anahtarınızı yazın.
# .env dosyası .gitignore'dadır; asla commit'lemeyin.

# --- Sohbet modeli (OpenAI uyumlu uç nokta) ---
# Aşağıdaki bloklardan yalnızca birini açık bırakın.

# (a) Google AI Studio — ücretsiz Gemini anahtarı (aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# (b) OpenRouter — dersin verdiği harcama limitli anahtar
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-6-luna

# (c) Ollama — yerel model, internetsiz
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b

# --- Gömme (embedding) modeli — RAG için ---
# Boş bırakılırsa yukarıdaki LLM_BASE_URL ve LLM_API_KEY kullanılır.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
